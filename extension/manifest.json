{
  "manifest_version": 3,
  "name": "Meu Downloader — Integração",
  "description": "Envia downloads do navegador para o app Meu Downloader (download segmentado e retomável).",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Meu Downloader",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["downloads", "cookies", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"]
}
